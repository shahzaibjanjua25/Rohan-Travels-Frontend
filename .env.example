# Base path for API requests.
#
# Leave as /api in development: vite.config.js proxies it to the backend so
# the browser treats app and API as one origin, which is what the SameSite=lax
# auth cookie requires.
#
# In production, serve the frontend and API under the same domain and keep
# this as /api. Only use an absolute URL if they are genuinely on different
# domains — that needs COOKIE_SAMESITE=none and COOKIE_SECURE=true on the
# backend, plus the frontend origin listed in its CORS_ORIGINS.
VITE_API_URL=/api
